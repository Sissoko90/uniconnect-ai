# Copy to .env and fill in. Never commit .env.

# Where the API is. On the VPS the worker and the API share a host, so this
# stays on loopback and never goes through nginx.
API_URL=http://127.0.0.1:8000

# Must be the SAME value as WORKER_TOKEN in the API's .env. Without it every
# endpoint except /ask is refused.
WORKER_TOKEN=

# The group to read and answer in. Get it with:  npm run groups
# It looks like 120363012345678901@g.us
GROUP_JID=

# The hour, in UTC, at which the daily digest is posted. 18 is early evening
# across the countries in this group.
DIGEST_HOUR_UTC=18
DIGEST_LANG=en

# How often to check for people who were named and have not come back.
ALERT_INTERVAL_MINUTES=5
