# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# POSTGRES_PASSWORD is required: docker compose refuses to start without it.
POSTGRES_USER=uniconnect
POSTGRES_PASSWORD=change_me
POSTGRES_DB=uniconnect
# Used by anything running OUTSIDE docker (the parser on your laptop).
# Inside docker the host is "db", not "localhost" - compose sets that itself.
DATABASE_URL=postgresql://uniconnect:change_me@localhost:5432/uniconnect

# --- Models -----------------------------------------------------------------
# Answer generation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Embeddings for hybrid search. 1024 dimensions, matching vector(1024)
# in db/schema.sql. Changing the model means changing the schema too.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIM=1024

# Call transcription, Whisper hosted on Groq.
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo

# --- API --------------------------------------------------------------------
API_PORT=8000
