# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# POSTGRES_PASSWORD is required: docker compose refuses to start without it.
POSTGRES_USER=uniconnect
POSTGRES_PASSWORD=change_me
POSTGRES_DB=uniconnect
# Used by anything running OUTSIDE docker (the parser on your laptop).
# Inside docker the host is "db", not "localhost" - compose sets that itself.
DATABASE_URL=postgresql://uniconnect:change_me@localhost:5432/uniconnect

# --- Models -----------------------------------------------------------------
# Answer generation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Embeddings for hybrid search. 1024 dimensions, matching vector(1024)
# in db/schema.sql. Changing the model means changing the schema too.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIM=1024

# Call transcription, Whisper hosted on Groq.
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo

# --- API --------------------------------------------------------------------
API_PORT=8000

# --- Guardrails -------------------------------------------------------------
# 153 members, no limit in WhatsApp, and roughly 1.3 cents a question. These
# exist so one person, or a loop between two bots, cannot spend the group's
# budget overnight.

# Per person. Generous for real use, low enough to contain one runaway.
MAX_QUESTIONS_PER_HOUR=20

# The same person sending the same words twice inside this window is a double
# tap or a retry, never a second question. Answered from the database, free.
REPEAT_WINDOW_SECONDS=30

# Dollars per day, everybody together. Past it the bot keeps answering from
# search alone instead of going silent - on voting day a blunter answer beats
# no answer. Set to 0 to disable the cap.
DAILY_SPEND_CAP_USD=10

# Catalogue price of CLAUDE_MODEL, per million tokens. Here rather than in the
# code so a price or model change needs no deployment.
PRICE_INPUT_PER_MTOK=5
PRICE_OUTPUT_PER_MTOK=25

# How close two questions must be to count as the same one. 0 is identical,
# 1 is unrelated. Raise it to catch more duplicates, lower it if it starts
# merging questions that are genuinely different.
DUPLICATE_DISTANCE=0.30
DUPLICATE_MAX_AGE_DAYS=30

# --- Digest -----------------------------------------------------------------
# The group is bilingual, so the model's choice of language for the daily
# digest changes from day to day, which reads as the bot being erratic.
# Pin it here: en, fr, or empty to let the model decide.
DIGEST_LANG=en

# How often live messages without a vector are picked up. The ingestion
# endpoint also triggers a pass immediately; this is the safety net.
EMBED_INTERVAL_SECONDS=60

# --- Worker authentication --------------------------------------------------
# Shared secret between the Baileys worker and the API. Most endpoints read or
# write a private group's messages, or cost money per call, and are refused
# without it. REQUIRED: unset, those endpoints return 503 rather than opening.
#
# Generate one:  openssl rand -hex 32
WORKER_TOKEN=
